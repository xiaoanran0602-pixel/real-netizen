root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell scripts must keep the UTF-8 BOM so that non-ASCII
# characters are not misread by Windows PowerShell 5.1 (CP936 fallback).
[*.ps1]
charset = utf-8-bom
end_of_line = crlf
